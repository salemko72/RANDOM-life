@echo off
cd /d "%~dp0"
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; try { if (-not (Test-Path 'scripts\preview.mjs')) { throw 'Stavi ISPRAVI_EXPO_GO.cmd u svoj RANDOM-life folder.' }; $utf8=[System.Text.UTF8Encoding]::new($false); $p=(Join-Path (Get-Location) 'scripts\preview.mjs'); $t=[IO.File]::ReadAllText($p); $q=[char]39; $old='EXPO_OFFLINE: '+$q+'1'+$q; $new='EXPO_OFFLINE: expoGo ? '+$q+'0'+$q+' : '+$q+'1'+$q; if (-not ($t.Contains($old) -or $t.Contains($new))) { throw 'Nepoznata verzija launchera. Koristi novi kompletni paket.' }; New-Item -ItemType Directory -Force '.random-repair-backups' | Out-Null; if (-not (Test-Path '.random-repair-backups\preview.mjs')) { Copy-Item $p '.random-repair-backups\preview.mjs' }; if (-not (Test-Path '.random-repair-backups\app.json')) { Copy-Item 'apps\client\app.json' '.random-repair-backups\app.json' }; $t=$t.Replace($old,$new).Replace('nema cloud ili AI API poziva','nema baze ili OpenAI API poziva'); [IO.File]::WriteAllText($p,$t,$utf8); if (-not (Test-Path 'apps\client\icon.png')) { Copy-Item 'apps\client\assets\icon.png' 'apps\client\icon.png' }; $configPath=(Join-Path (Get-Location) 'apps\client\app.json'); $config=Get-Content -Raw $configPath | ConvertFrom-Json; if ($config.expo.icon -eq './assets/icon.png') { $config.expo.icon='./icon.png'; [IO.File]::WriteAllText($configPath,($config | ConvertTo-Json -Depth 50),$utf8) }; $env:EXPO_OFFLINE='0'; Write-Host 'Provjeravam Expo prijavu...'; & node.exe node_modules/expo/bin/cli whoami; if ($LASTEXITCODE -ne 0) { & node.exe node_modules/expo/bin/cli login; if ($LASTEXITCODE -ne 0) { throw 'Expo prijava nije zavrsena.' } }; Write-Host 'Ispravka zavrsena. Pokrecem novi QR kod.'; & node.exe scripts/preview.mjs --go; exit $LASTEXITCODE } catch { Write-Host $_.Exception.Message -ForegroundColor Red; exit 1 }"
if errorlevel 1 pause

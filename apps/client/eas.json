{
  "cli": {
    "version": ">=24.14.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "node": "24.19.0",
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_LIFESPINNER_ADS_MODE": "test"
      }
    },
    "production": {
      "node": "24.19.0",
      "distribution": "store",
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_LIFESPINNER_ADS_MODE": "test"
      }
    },
    "testflight": {
      "extends": "production",
      "ios": {
        "simulator": false
      }
    },
    "ios-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "play-ads-test": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_LIFESPINNER_ADS_MODE": "test"
      }
    },
    "play-ads-live": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_LIFESPINNER_ADS_MODE": "live"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6830084481",
        "appleTeamId": "MNQY6SH96C"
      }
    }
  }
}

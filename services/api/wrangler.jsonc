{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "random-test-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "CONTENT_DB",
      "database_name": "random-test-content",
      "database_id": "d47c89e2-e2ab-42fd-be29-dce5ba809b6d",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
